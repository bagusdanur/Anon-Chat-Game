{
  "name": "anon-chat-bot",
  "version": "1.0.0",
  "description": "Telegram anonymous random chat bot (Omegle-style pairing)",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/*.test.js",
    "dashboard:dev": "cd dashboard && npx vite",
    "dashboard:build": "cd dashboard && npx vite build",
    "simulate:economy": "node scripts/economySimulation.js",
    "report:economy": "node scripts/economyProductionReport.js",
    "simulate:combat": "node scripts/combatBalanceSimulation.js",
    "simulate:dungeon": "node scripts/dungeonBalanceSimulation.js",
    "simulate:equipment": "node scripts/equipmentBalanceSimulation.js",
    "simulate:progression": "node scripts/progressionSimulation.js",
    "simulate:saga": "node scripts/simulate_live_service_saga.js",
    "build:patches": "node data/patch_loader.js",
    "migration:dry-run": "node scripts/migrationDryRun.js",
    "feature:set": "node scripts/setFeatureFlag.js",
    "db:backup": "node scripts/databaseMaintenance.js backup",
    "db:check": "node scripts/databaseMaintenance.js check"
  },
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "telegraf": "^4.16.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "vite": "^8.1.5"
  }
}
